# --- База данных ---
DATABASE_URL="postgresql://taskmanager:taskmanager@localhost:5432/taskmanager?schema=public"

# Название компании: показывается на странице входа, в подвале и заголовке вкладки
COMPANY_NAME="Компания Baraka N1"

# --- Авторизация ---
# Секрет для подписи JWT. Обязательно замените в проде: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Время жизни сессии в часах
SESSION_TTL_HOURS="12"
# Помечать cookie сессии как "только для HTTPS".
# true — когда сайт открыт по https:// (в интернете, обязательно).
# false — когда приложение работает во внутренней сети по http://адрес:3000,
#         иначе браузер не сохранит cookie и вход не сработает.
COOKIE_SECURE="true"

# --- Вложения ---
# Где хранить содержимое вложений:
#   disk     — на диске в UPLOAD_DIR (по умолчанию, для своего сервера)
#   database — прямо в базе; нужно на хостингах без постоянного диска (Vercel и т.п.)
STORAGE_DRIVER="disk"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="20"

# --- Планировщик ---
# Часовой пояс, в котором считаются "сутки" для дедлайнов и отчётов
APP_TIMEZONE="Europe/Moscow"
# Время формирования ежедневного отчёта (HH:MM), можно менять в разделе "Настройки"
DAILY_REPORT_TIME="18:00"
# Секрет для вызова /api/cron/* извне (системный crontab, Vercel Cron)
CRON_SECRET="change-me-too"

# --- Письма (необязательно) ---
# Ключ Resend: нужен для восстановления пароля по ссылке из письма.
# Пусто — форма "Забыли пароль" честно скажет обратиться к администратору.
RESEND_API_KEY=""
# Адрес отправителя на подтверждённом домене, например "Task Manager <tasks@baraka.uz>"
MAIL_FROM=""
# Адрес приложения для ссылок в письмах (на Vercel можно не задавать)
APP_URL=""

# --- Мониторинг ошибок (необязательно) ---
# DSN проекта в Sentry. Пусто — мониторинг выключен, приложение работает как обычно.
SENTRY_DSN=""
# Тот же DSN для ошибок в браузере (переменная видна на клиенте)
NEXT_PUBLIC_SENTRY_DSN=""

# --- Telegram (необязательно) ---
# Токен бота от @BotFather. Без него уведомления остаются только внутри приложения.
TELEGRAM_BOT_TOKEN=""
# Имя бота для ссылки в разделе "Профиль", например @baraka_tasks_bot
TELEGRAM_BOT_NAME=""
# Произвольная строка: Telegram присылает её в заголовке, чтобы вебхук не дёргали посторонние
TELEGRAM_WEBHOOK_SECRET=""

# --- Сид ---
SEED_DEFAULT_PASSWORD="Password123!"
